{
  "name": "zucker-framework",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Full-stack NestJS + Next.js framework - TypeScript port of hsweb-framework",
  "license": "Apache-2.0",
  "author": "Lind",
  "scripts": {
    "dev": "turbo run dev --filter='@zucker/template-*'",
    "dev:server": "pnpm --filter @zucker/template-server dev",
    "dev:admin": "pnpm --filter @zucker/template-admin dev",
    "dev:web": "pnpm --filter @zucker/template-web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "vitest run",
    "test:durable-runtime": "pnpm --filter @zucker/task build && vitest run packages/task/src/postgres-task-repository.integration.spec.ts packages/task/src/worker-restart.integration.spec.ts packages/queue/src/bullmq.integration.spec.ts",
    "verify:package-artifacts": "node scripts/verify-package-artifacts.mjs",
    "pack:rc": "node scripts/verify-package-artifacts.mjs --output artifacts/rc",
    "publish:rc": "node scripts/publish-release-candidates.mjs",
    "test:e2e:server": "pnpm --filter @zucker/template-server test:e2e",
    "test:e2e:ui": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
