#!/bin/sh
# 推送 main 之前的本地门。main 的 CI 不再重复 test / lint（见 docs/package-release.md），
# 所以这里是它们唯一的执行点：任一失败即拒绝推送。持久化契约（PostgreSQL/Redis）由
# pull request 的 pr-checks.yml 运行，也可手动执行 scripts/verify-nas-integration.mjs，不阻塞推送。
#
# 可选环境变量：
#   ZUCKER_SKIP_PREPUSH  只允许用于纯文档/流程提交（见 package-release.md 的记录要求）。
set -eu

remote="$1"
pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main) pushing_main=1 ;; esac
done
[ "$pushing_main" -eq 1 ] || exit 0

if [ "${ZUCKER_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: ZUCKER_SKIP_PREPUSH=1 —— 跳过本地门（仅限不改动包字节的提交）" >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

step() { printf '\n▶ pre-push: %s\n' "$1" >&2; }

step "build packages"
pnpm build:packages

step "package content + legal"
pnpm legal:prepare >/dev/null
pnpm verify:package-content

step "unit tests"
pnpm test

step "lint"
pnpm lint


step "package artifacts (same check as CI)"
# 该脚本拒绝覆盖已有输出目录，每次用新目录，保留旧的评审产物。
node scripts/verify-package-artifacts.mjs --output "artifacts/review-prepush-$(date +%s)" --allow-dirty

echo "\n✅ pre-push: 本地门全部通过，允许推送 main" >&2
