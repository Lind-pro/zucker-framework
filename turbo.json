{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "tsup.config.*",
        "build-vendored.mjs",
        "../../tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "../../eslint.config.cjs",
        "../../tsconfig.base.json"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "../../vitest.config.ts",
        "../../vitest.setup.ts"
      ]
    },
    "clean": {
      "cache": false
    }
  },
  "globalPassThroughEnv": ["pnpm_config_verify_deps_before_run"],
  "globalEnv": ["DEV_DEPENDENCY_LOCK_HASH"]
}
