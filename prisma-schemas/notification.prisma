// 通知模型

enum NotifyChannelType {
  EMAIL
  SMS
  WEBHOOK
  IN_APP
  PUSH
}

enum NotifyStatus {
  PENDING
  SENT
  FAILED
  READ
}

model notifyTemplates {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  channel     NotifyChannelType
  subject     String?
  content     String
  contentType String   @default("text")
  variables   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("notify_templates")
}

model notifySubscribers {
  id          String            @id @default(cuid())
  userId      String
  channel     NotifyChannelType
  topicCode   String
  enabled     Boolean           @default(true)
  config      Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@unique([userId, channel, topicCode])
  @@index([userId])
  @@index([topicCode])
  @@map("notify_subscribers")
}

model notifyChannels {
  id           String            @id @default(cuid())
  name         String
  type         NotifyChannelType
  config       Json
  isDefault    Boolean           @default(false)
  status       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@map("notify_channels")
}

model notifyHistory {
  id           String            @id @default(cuid())
  templateCode String?
  channel      NotifyChannelType
  recipient    String
  subject      String?
  content      String
  status       NotifyStatus      @default(PENDING)
  sendAt       DateTime?
  readAt       DateTime?
  errorMessage String?
  metadata     Json?
  retryCount   Int               @default(0)
  createdAt    DateTime          @default(now())

  @@index([channel, status])
  @@index([recipient, createdAt])
  @@index([status])
  @@map("notify_history")
}
