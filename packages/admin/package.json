{
  "name": "@zucker-framework/admin",
  "version": "1.0.18",
  "description": "Zucker Admin — pluggable management REST API module for NestJS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/event-emitter --external @zucker-framework/auth --external @zucker-framework/crud --external @zucker-framework/core --external @zucker-framework/dictionary --external @zucker-framework/config --external @zucker-framework/credit --external @zucker-framework/logging --external @zucker-framework/notification --external @zucker-framework/form",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@zucker-framework/ai": "workspace:*",
    "@zucker-framework/auth": "workspace:*",
    "@zucker-framework/common": "workspace:*",
    "@zucker-framework/config": "workspace:*",
    "@zucker-framework/core": "workspace:*",
    "@zucker-framework/credit": "workspace:*",
    "@zucker-framework/crud": "workspace:*",
    "@zucker-framework/dictionary": "workspace:*",
    "@zucker-framework/fe-types": "workspace:*",
    "@zucker-framework/form": "workspace:*",
    "@zucker-framework/logging": "workspace:*",
    "@zucker-framework/notification": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/admin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
