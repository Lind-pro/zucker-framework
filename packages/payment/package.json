{
  "name": "@zucker-framework/payment",
  "version": "1.0.10",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/event-emitter --external @zucker-framework/core",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@zucker-framework/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "stripe": "^22.6.1",
    "@paypal/paypal-server-sdk": "^2.5.0"
  },
  "devDependencies": {
    "@nestjs/event-emitter": "^12.0.0",
    "stripe": "22.6.1",
    "@paypal/paypal-server-sdk": "2.5.0"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/payment"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    },
    "@paypal/paypal-server-sdk": {
      "optional": true
    }
  }
}
