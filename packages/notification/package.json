{
  "name": "@zucker/notification",
  "version": "0.1.0-rc.5",
  "description": "Notification providers and durable delivery primitives for Zucker applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run --root ../.. packages/notification/src"
  },
  "dependencies": {
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@zucker/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@zucker/core": ">=0.1.0-rc.2 <0.2.0"
  },
  "license": "Apache-2.0"
}
