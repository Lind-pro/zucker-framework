{
  "name": "@zucker-framework/notification",
  "version": "1.0.26",
  "description": "Notification providers and durable delivery primitives for Zucker applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run --root ../.. packages/notification/src",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@zucker-framework/core": "workspace:*",
    "@zucker-framework/queue": "workspace:*",
    "pg": "8.23.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@zucker-framework/core": "workspace:*",
    "resend": "^6.26.0",
    "@zucker-framework/queue": "workspace:*"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/notification"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "resend": {
      "optional": true
    }
  }
}
