/// 扩展产品注册表：新插件上架只需插一行（slug 与 Stripe client_reference_id 一致），
/// 邮件品牌/显示名由此驱动，未登记的 slug 走代码内 fallback。
model ExtensionProduct {
  slug        String  @id // 消费项目提供的产品标识
  displayName String // 邮件中显示的产品名
  senderBrand String // 发件人品牌
  purchaseUrl String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("extension_products")
}
