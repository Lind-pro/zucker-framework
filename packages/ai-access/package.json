{
  "name": "@zucker/ai-access",
  "version": "0.1.0-rc.10",
  "description": "Provider-neutral AI credential profiles, authentication drivers, and runtimes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./openai-codex": {
      "import": {
        "types": "./dist/openai-codex.d.mts",
        "default": "./dist/openai-codex.mjs"
      },
      "require": {
        "types": "./dist/openai-codex.d.ts",
        "default": "./dist/openai-codex.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/openai-codex.ts --format cjs,esm --dts --clean",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "openai": ">=7.8.0 <8"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "8.23.1",
    "openai": "^7.8.0",
    "pg": "8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
