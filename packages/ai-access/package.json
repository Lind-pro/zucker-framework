{
  "name": "@zucker-framework/ai-access",
  "version": "1.0.2",
  "description": "Provider-neutral AI credential profiles, authentication drivers, and runtimes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./openai-codex": {
      "import": {
        "types": "./dist/openai-codex.d.mts",
        "default": "./dist/openai-codex.mjs"
      },
      "require": {
        "types": "./dist/openai-codex.d.ts",
        "default": "./dist/openai-codex.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/openai-codex.ts --format cjs,esm --dts --clean",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "peerDependencies": {
    "openai": ">=7.8.0 <8"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "8.23.1",
    "openai": "^7.9.0",
    "pg": "8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/ai-access"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
