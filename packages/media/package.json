{
  "name": "@zucker-framework/media",
  "version": "1.0.11",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser.d.mts",
          "default": "./dist/browser.mjs"
        },
        "require": {
          "types": "./dist/browser.d.ts",
          "default": "./dist/browser.js"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format cjs,esm --dts --external @rdkit/rdkit --external vega --external vega-lite",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/media"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "mermaid": "^11.17.2",
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "@rdkit/rdkit": {
      "optional": true
    },
    "vega": {
      "optional": true
    },
    "vega-lite": {
      "optional": true
    }
  },
  "devDependencies": {
    "mermaid": "11.17.2",
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "@types/node": "20.19.43"
  }
}
