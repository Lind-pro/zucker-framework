{
  "name": "@zucker-framework/ai",
  "version": "1.0.28",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "dependencies": {
    "@zucker-framework/ai-access": "workspace:*",
    "jsonrepair": "^3.15.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/langchain.ts src/native.ts src/testing.ts --format cjs,esm --dts --external @langchain/core --external @google/genai --external openai --external @langchain/openai --external @langchain/anthropic --external https-proxy-agent --external zod --external @zucker-framework/common",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "devDependencies": {
    "@zucker-framework/core": "workspace:*",
    "@types/node": "^20.19.43",
    "openai": "^7.9.0",
    "@langchain/core": "^1.2.9",
    "@google/genai": "^2.20.0",
    "@langchain/openai": "^1.5.11",
    "@langchain/anthropic": "^1.5.9",
    "https-proxy-agent": "^9.1.0",
    "zod": "^4.5.4",
    "@zucker-framework/common": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@zucker-framework/core": "workspace:*",
    "openai": ">=7.8.0 <8",
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/generative-ai": "^0.24.1",
    "replicate": "^1.4.0",
    "@langchain/core": "^1.2.9",
    "@google/genai": "^2.20.0",
    "@langchain/openai": "^1.5.11",
    "@langchain/anthropic": "^1.5.9",
    "https-proxy-agent": "^9.1.0",
    "zod": "^4.5.4",
    "@zucker-framework/common": "workspace:*"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "replicate": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@langchain/openai": {
      "optional": true
    },
    "@langchain/anthropic": {
      "optional": true
    },
    "https-proxy-agent": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.mts",
        "default": "./dist/langchain.mjs"
      },
      "require": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.mts",
        "default": "./dist/native.mjs"
      },
      "require": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  }
}
