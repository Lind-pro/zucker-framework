{
  "name": "@zucker-framework/auth",
  "version": "1.0.2",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/passport --external @nestjs/jwt --external rxjs --external @zucker-framework/core --external @zucker-framework/crud --external @zucker-framework/cache",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@zucker-framework/core": "workspace:*",
    "@zucker-framework/crud": "workspace:*",
    "passport-jwt": "^4.0.1",
    "@types/passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@zucker-framework/cache": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "rxjs": "^7.0.0",
    "@zucker-framework/cache": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zucker-framework/cache": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
