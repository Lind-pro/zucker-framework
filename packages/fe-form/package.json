{
  "name": "@zucker/fe-form",
  "version": "0.0.1",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@types/react": "^19.2.18",
    "antd": "^6.6.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.6.1 <7",
    "antd": ">=5.29.3 <7",
    "react": "^19.0.0"
  }
}
