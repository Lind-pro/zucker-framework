        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "antd": "^6.6.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.6.1 <7",
    "antd": ">=5.29.3 <7",
    "react": "^19.0.0"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/fe-form"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
