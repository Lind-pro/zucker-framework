{
  "name": "@zucker-framework/event",
  "version": "1.0.13",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/event-emitter --external class-transformer --external class-validator --external @zucker-framework/core --external rxjs",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@zucker-framework/core": "workspace:*",
    "eventemitter2": "^6.4.9"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0 || ^0.15.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "rxjs": "^7.8.2"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/event"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
