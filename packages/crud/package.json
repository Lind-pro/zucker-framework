{
  "name": "@zucker/crud",
  "version": "0.0.1",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external @nestjs/common --external @nestjs/core --external @nestjs/swagger --external @zucker/core --external @zucker/event --external @zucker/cache --external eventemitter2",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@zucker/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@zucker/cache": "workspace:*",
    "@zucker/event": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zucker/cache": {
      "optional": true
    },
    "@zucker/event": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/swagger": "^12.0.1",
    "@types/node": "^20.19.43"
  }
}
