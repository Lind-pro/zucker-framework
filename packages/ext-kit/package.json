{
  "name": "@zucker-framework/ext-kit",
  "version": "1.0.26",
  "description": "Browser extension infrastructure kit — batch engine, capture session, licensing, popup driver. Vendored into extensions as ext-kit.js / ext-kit-popup.js.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "assets/offscreen.html",
    "assets/offscreen.js",
    "assets/package.mjs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup && node build-vendored.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test:unit": "node --test test/engine.test.cjs test/licensing.test.cjs test/lifecycle.test.cjs && vitest run --root ../.. packages/ext-kit/src/naming.spec.ts",
    "test:browser": "node --test test/browser.test.cjs",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/ext-kit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
