/// Reference schema fragment for @zucker-framework/ai-tasks.
///
/// Copy these models into the consuming application's Prisma schema next to the
/// durable task models of @zucker-framework/task (`async_jobs`). `AITask.id` is the
/// `async_jobs.id`; the durable row owns status, lease and fencing. Owners are
/// referenced by scalar id. The CHECK constraints of assets/ai-tasks.postgresql.sql
/// (kind, holdState, hold consistency, non-negative cost/bytes) cannot be expressed
/// in Prisma; add them to the generated migration SQL.
model AITask {
  id              String         @id
  ownerId         String
  kind            String
  providerId      String
  model           String
  cost            Int
  holdId          String?
  holdState       String
  providerTaskId  String?
  pollCount       Int            @default(0)
  pollErrors      Int            @default(0)
  deferrals       Int            @default(0)
  nextPollAt      DateTime?
  wakeRequestedAt DateTime?
  deadlineAt      DateTime
  callbackOutcome Json?
  createdAt       DateTime
  updatedAt       DateTime
  outputs         AITaskOutput[]

  @@unique([providerId, providerTaskId], map: "ai_tasks_provider_task_key")
  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "ai_tasks_owner_created_idx")
  @@index([holdState], map: "ai_tasks_hold_state_idx")
  @@map("ai_tasks")
}

model AITaskOutput {
  taskId      String
  index       Int
  storageKey  String
  contentType String
  bytes       Int
  sha256      String
  createdAt   DateTime
  task        AITask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, index])
  @@map("ai_task_outputs")
}
