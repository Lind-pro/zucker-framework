{
  "name": "@zucker-framework/ai-tasks",
  "version": "1.0.21",
  "description": "Durable, credit-metered asynchronous AI media generation tasks (submit, poll, callback, re-host) for Zucker applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters.d.mts",
        "default": "./dist/adapters.mjs"
      },
      "require": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets/ai-tasks.prisma",
    "assets/ai-tasks.postgresql.sql",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/adapters.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "peerDependencies": {
    "@zucker-framework/ai": "workspace:*",
    "@zucker-framework/core": "workspace:*",
    "@zucker-framework/credit": "workspace:*",
    "@zucker-framework/storage": "workspace:*",
    "@zucker-framework/task": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zucker-framework/credit": {
      "optional": true
    },
    "@zucker-framework/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "8.23.1",
    "@zucker-framework/ai": "workspace:*",
    "@zucker-framework/core": "workspace:*",
    "@zucker-framework/credit": "workspace:*",
    "@zucker-framework/storage": "workspace:*",
    "@zucker-framework/task": "workspace:*",
    "pg": "8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/ai-tasks"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
