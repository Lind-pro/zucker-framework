{
  "name": "@zucker-framework/fe-site",
  "version": "1.0.23",
  "description": "Optional site advertising, referral and support connections with controlled public configuration.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./content": {
      "import": { "types": "./dist/content.d.mts", "default": "./dist/content.mjs" },
      "require": { "types": "./dist/content.d.ts", "default": "./dist/content.js" }
    }
  },
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE", "THIRD_PARTY_NOTICES"],
  "scripts": {
    "build": "tsup src/index.ts src/content.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git", "url": "git+https://github.com/Lind-pro/zucker-framework.git", "directory": "packages/fe-site"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
