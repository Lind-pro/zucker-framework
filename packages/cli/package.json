{
  "name": "@zucker-framework/cli",
  "version": "1.0.6",
  "description": "CLI tool for Zucker Framework — scaffolding, diagnostics, and module management",
  "bin": {
    "zucker": "./dist/index.js"
  },
  "main": "dist/tooling.js",
  "types": "dist/tooling.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "tooling/agent-instructions.mjs",
    "tooling/agent-instructions.d.mts"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ../../scripts/prepare-cli-catalog.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@zucker-framework/ai-access": "workspace:*",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "7.8.0",
    "pg": "8.23.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "module": "dist/tooling.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/tooling.d.mts",
        "default": "./dist/tooling.mjs"
      },
      "require": {
        "types": "./dist/tooling.d.ts",
        "default": "./dist/tooling.js"
      }
    },
    "./agent-instructions": {
      "types": "./tooling/agent-instructions.d.mts",
      "import": "./tooling/agent-instructions.mjs",
      "default": "./tooling/agent-instructions.mjs"
    }
  }
}
