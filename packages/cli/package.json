{
  "name": "@zucker-framework/cli",
  "version": "1.0.1",
  "description": "CLI tool for Zucker Framework — scaffolding, diagnostics, and module management",
  "bin": {
    "zucker": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts && node ../../scripts/prepare-cli-catalog.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@zucker-framework/ai-access": "workspace:*",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "7.8.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
