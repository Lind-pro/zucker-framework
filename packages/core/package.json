{
  "name": "@zucker-framework/core",
  "version": "1.0.17",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./privacy": {
      "import": {
        "types": "./dist/privacy.d.mts",
        "default": "./dist/privacy.mjs"
      },
      "require": {
        "types": "./dist/privacy.d.ts",
        "default": "./dist/privacy.js"
      }
    },
    "./user-agent": {
      "import": {
        "types": "./dist/user-agent.d.mts",
        "default": "./dist/user-agent.mjs"
      },
      "require": {
        "types": "./dist/user-agent.d.ts",
        "default": "./dist/user-agent.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/privacy.ts src/user-agent.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "prepack": "node ../../scripts/prepare-package-legal.mjs"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "zod": "^4.5.4",
    "dayjs": "^1.11.23",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  },
  "license": "Apache-2.0",
  "author": "Lind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lind-pro/zucker-framework.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
