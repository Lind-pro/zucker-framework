    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}
