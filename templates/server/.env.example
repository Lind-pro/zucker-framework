# Use this application's isolated PostgreSQL database/schema. Never copy another product's live environment.
DATABASE_URL=
JWT_SECRET=
# Separate from JWT; protects administrator-saved provider settings. Preserve across restarts.
# Also encrypts two-factor (TOTP) secrets: without it enrolment is refused, and enrolled accounts
# cannot sign in (503 TWO_FACTOR_UNAVAILABLE). Rotating it makes existing 2FA secrets unreadable.
CONFIG_ENCRYPTION_KEY=
PORT=4200
ACCOUNT_ORIGINS=http://localhost:4201,http://localhost:4202
WEB_URL=http://localhost:4202
# Behind a reverse proxy/load balancer: trusted hop count (e.g. 1) or proxy IPs/CIDRs. Per-IP rate
# limits use the client address only when this is set; `true` is refused (spoofable X-Forwarded-For).
TRUST_PROXY=
# Optional Redis (redis://...) for rate-limit budgets shared across replicas and restarts (`ioredis` is
# installed). Without it every process keeps its own in-memory budgets, so limits multiply by the replica
# count; production startup logs a warning.
RATE_LIMIT_REDIS_URL=

# Retention of operational tables, in days (0 keeps forever). Purged hourly in bounded batches by the
# job host: API-key usage rows, access logs, revoked/expired sessions and completed internal
# reconciliation jobs. User job results, orders, ledgers and files are never purged.
RETENTION_API_KEY_USAGE_DAYS=90
RETENTION_ACCESS_LOG_DAYS=180
RETENTION_SESSION_DAYS=30
RETENTION_MAINTENANCE_JOB_DAYS=30
# Rows per delete batch (one transaction each) and batches per table per hourly run. Raise the batch
# count to drain an existing backlog faster; defaults remove up to 50,000 rows per table per run.
RETENTION_BATCH_SIZE=1000
RETENTION_MAX_BATCHES_PER_RUN=50

# Demo `record` job counter. Empty: unlimited outside production, 100 per period with NODE_ENV=production;
# `off` disables the counter explicitly.
QUOTA_RECORD_LIMIT=
QUOTA_RECORD_PERIOD=daily

# One transport (connection profile `account-email`) sends account verification/reset/welcome mail,
# purchase receipts and MailService mail (templates, email_logs). MAIL_PROVIDER: smtp (default) or
# resend (MAIL_RESEND_API_KEY); SMTP_FROM is the sender for both. Missing mail settings produce an
# explicit unavailable response, not a fake verification success. SMTP_USER/SMTP_PASSWORD may stay empty
# for a local catcher without authentication.
MAIL_PROVIDER=smtp
MAIL_RESEND_API_KEY=
# Name shown in mail subjects and bodies; empty uses the host of WEB_URL.
SITE_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Product policies are edited in the admin (Policies) and apply without a restart. An environment
# value pins a field (shown read-only in the admin): POLICY_<POLICY>_<FIELD>, e.g. sign-up without a
# mail transport during local development. Empty means "not pinned".
POLICY_ACCOUNT_REQUIRE_EMAIL_VERIFICATION=

# Signs cache revalidation calls to WEB_URL/api/revalidate after CMS writes (at least 32 characters,
# the same value as the Web app's REVALIDATE_SECRET). Empty: Web pages refresh on their cache timer.
REVALIDATE_SECRET=
# File-backed starter content (pages, posts, docs, changelog) served next to the CMS and copied into it
# by `pnpm account:admin` / `pnpm content:seed`. Relative to the working directory.
# CONTENT_DIR=content

# Durable job notifications are separate from account verification/reset mail.
# Leave disabled until this application's delivery provider is configured.
DELIVERY_PROVIDER=none
DELIVERY_ACCOUNT_SCOPE=
DELIVERY_FROM=
DELIVERY_RESEND_API_KEY=
DELIVERY_SMTP_HOST=
DELIVERY_SMTP_PORT=587
DELIVERY_SMTP_SECURE=false
DELIVERY_SMTP_USER=
DELIVERY_SMTP_PASSWORD=
# Resend idempotent replay window: at most 23 hours (milliseconds).
DELIVERY_REPLAY_WINDOW_MS=82800000

# Optional one-time administrator setup; never read during application startup. `pnpm account:admin`
# also seeds starter plans/credit packs from BILLING_CATALOG_JSON and the content/ documents once.
# `pnpm account:role -- --email <address> --role <name-or-id>` grants an existing role to an account.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional identity providers. Disabled until explicitly enabled and configured.
# Register callbacks at WEB_URL/api/authorize/oauth/{google|github}/callback.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_ONE_TAP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Paid offers are application-owned. Empty by default; JSON items include
# id/title/version/mode/amount/currency/credits/expiresInDays/providers.
# Supports payment and subscription. PayPal subscriptions require explicit
# subscriptionGrantBasis: { "paypal": "payment" }; other channels use proven periods.
BILLING_CATALOG_JSON=[]
# Subscription offers above seed subscription_plans once (pnpm account:admin): one monthly price with the
# offer's provider references. From then on plans are the only source of plan prices (edited in the back
# office) and a seeded offer is sold as its plan; unseeded subscription offers remain credit-only subscriptions.
# Month/day plan counters roll over in this IANA time zone. Changing it mid-period changes the period
# keys, so the current month/day starts a new counter; change it only at a period boundary.
# Reservation TTL is 1000-86400000 ms and must exceed the longest metered work.
ENTITLEMENT_TIME_ZONE=UTC
ENTITLEMENT_RESERVATION_TTL_MS=900000
BILLING_REFERRAL_PROVIDERS=
BILLING_STRIPE_ENABLED=false
BILLING_STRIPE_MODE=test
BILLING_STRIPE_ACCOUNT_SCOPE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PAYPAL_ENABLED=false
BILLING_PAYPAL_MODE=sandbox
BILLING_PAYPAL_ACCOUNT_SCOPE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
BILLING_CREEM_ENABLED=false
BILLING_CREEM_MODE=test
BILLING_CREEM_ACCOUNT_SCOPE=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# TEST ONLY: in-memory `fake` payment provider (checkout, subscriptions, refunds) with a hosted test
# page at /api/billing/test-checkout/* for local demos and the real-stack acceptance run. Refused when
# NODE_ENV=production; any value other than true/false fails the boot. Give credit packs or plans a
# `fake` provider reference to sell them through it. Never set this on a deployed server.
# BILLING_TEST_FAKE_PROVIDER=false
# Absolute base URL of the fake hosted page; default ${WEB_URL}/api/billing/test-checkout.
# BILLING_TEST_FAKE_CHECKOUT_URL=

# Private attachments use the one shared FileManager. Local is development-only;
# NODE_ENV=production requires an explicitly configured s3 provider and private bucket.
FILES_STORAGE_PROVIDER=local
FILES_LOCAL_PATH=./uploads
FILES_MAX_BYTES=10485760
# Per-owner limits over non-deleted files (uploads, imports, avatars): bytes and count.
FILES_OWNER_MAX_BYTES=1073741824
FILES_OWNER_MAX_FILES=1000
# Short-lived private download tickets and optional bounded remote import.
# Empty import allowlist disables remote imports. Use exact trusted HTTPS hosts, never wildcards.
FILES_DOWNLOAD_TTL_SECONDS=60
FILES_IMPORT_ALLOWED_HOSTS=
# Public site images (logos, block images) uploaded in the admin: largest upload in bytes (default
# 5 MiB, at most 10485760) and an optional CDN origin. With a CDN, allow anonymous GET on the
# bucket's public-assets/* prefix only; everything else stays private.
PUBLIC_ASSETS_MAX_BYTES=
PUBLIC_ASSETS_BASE_URL=
FILES_IMPORT_TIMEOUT_MS=15000
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
FILES_S3_REGION=us-east-1
FILES_S3_ENDPOINT=
# Optional; if omitted, a custom endpoint enables path-style requests.
# FILES_S3_FORCE_PATH_STYLE=true
# Streamed uploads to S3 use multipart parts of this size (bytes, 5 MiB..5 GiB; default 8 MiB). Add a
# bucket lifecycle rule that aborts incomplete multipart uploads (e.g. after 1 day).
FILES_S3_PART_SIZE_BYTES=
# A stored object that no file row claims after this many minutes (crash between upload and insert)
# is removed by the `file-orphans` sweeper. Default 60.
FILES_ORPHAN_GRACE_MINUTES=

# In-app notifications (/api/inbox): read or archived notifications older than this many days are
# deleted (default 90; 0 keeps them forever).
INBOX_RETENTION_DAYS=

# AI connections. Chat (/api/chat) uses every enabled connection unless the ai-catalog policy lists
# models; image generation uses the OpenAI connection (DALL-E) when enabled. Prices and the offered
# model catalog are the hot-applied ai-pricing / ai-catalog policies (admin: AI > Models & pricing),
# pinnable per kind, e.g. POLICY_AI_PRICING_IMAGE={"default":2,"byModel":{}}.
# Credentials can instead be saved in the protected connection settings. All are off by default.

AI_OPENAI_ENABLED=false
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL_ID=
AI_OPENAI_BASE_URL=
AI_OPENAI_MAX_TOKENS=
AI_OPENAI_TIMEOUT_MS=60000

AI_COMPATIBLE_ENABLED=false
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL_ID=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MAX_TOKENS=
AI_COMPATIBLE_TIMEOUT_MS=60000

AI_OPENROUTER_ENABLED=false
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL_ID=
AI_OPENROUTER_BASE_URL=
AI_OPENROUTER_MAX_TOKENS=
AI_OPENROUTER_TIMEOUT_MS=60000

AI_DEEPSEEK_ENABLED=false
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL_ID=
AI_DEEPSEEK_BASE_URL=
AI_DEEPSEEK_MAX_TOKENS=
AI_DEEPSEEK_TIMEOUT_MS=60000

AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL_ID=
AI_ANTHROPIC_BASE_URL=
AI_ANTHROPIC_MAX_TOKENS=
AI_ANTHROPIC_TIMEOUT_MS=60000

AI_GEMINI_ENABLED=false
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL_ID=
AI_GEMINI_BASE_URL=
AI_GEMINI_MAX_TOKENS=
AI_GEMINI_TIMEOUT_MS=60000

# Vendor-neutral async media adapters (video/music/image providers with submit + poll APIs), a JSON
# array of HttpAsyncTaskAdapterConfig (see docs/ai-quickstart.md). Each adapter <ID> needs
# AI_MEDIA_<ID>_API_KEY (unless auth.type is none) and, when it declares `callback`,
# AI_MEDIA_<ID>_CALLBACK_SECRET (HMAC). Callbacks only wake the poller; results are always fetched.
AI_MEDIA_ADAPTERS=
# AI_MEDIA_EXAMPLE_API_KEY=
# AI_MEDIA_EXAMPLE_CALLBACK_SECRET=
# Longest provider wait before a task fails and its credit hold is released (minutes, 1..1440).
AI_TASKS_IMAGE_MAX_WAIT_MINUTES=10
AI_TASKS_VIDEO_MAX_WAIT_MINUTES=30
AI_TASKS_AUDIO_MAX_WAIT_MINUTES=20
# Largest single AI output (bytes), streamed into the owner's private files (counts toward the
# FILES_OWNER_* quota). Default 200 MiB, at most 1073741824; images use min(this, 20 MiB).
AI_OUTPUT_MAX_BYTES=209715200
# Upper bound of one chat answer in tokens (16..1048576); the hold covers this many output tokens.
CHAT_MAX_OUTPUT_TOKENS=4096
# TEST ONLY: deterministic fake chat/media providers for local end-to-end runs. Refused when
# NODE_ENV=production. Never set this on a deployed server.
# AI_TEST_FAKE_PROVIDERS=false
