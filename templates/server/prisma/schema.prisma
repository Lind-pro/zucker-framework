  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@index([state, cleanupStatus, updatedAt])
  @@map("file_assets")
}

/// Reference schema fragment for the durable task control plane.
///
/// Copy these models and enums into the consuming application's Prisma schema,
/// then add application-owned relations and migrations there. The framework
/// package intentionally does not generate or ship a Prisma Client.
enum AsyncJobStatus {
  QUEUED
  PROCESSING
  WAITING_PROVIDER
  RETRYING
  COMPLETED
  FAILED
  CANCELLED

  @@map("async_job_status")
}

enum AsyncJobOutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED

  @@map("async_job_outbox_status")
}

model AsyncJob {
  id                     String           @id
  kind                   String
  resourceType           String
  resourceId             String
  userId                 String?
  orderId                String?
  status                 AsyncJobStatus   @default(QUEUED)
  stage                  String?
  progress               Int              @default(0)
  attempt                Int              @default(0)
  maxAttempts            Int
  idempotencyKey         String           @unique
  idempotencyFingerprint String
  handlerVersion         String
  payload                Json
  result                 Json?
  errorCode              String?
  errorCategory          String?
  errorSummary           String?
  errorRetryable         Boolean?
  errorMetadata          Json?
  providerRequestId      String?
  workerId               String?
  leaseToken             String?
  leaseExpiresAt         DateTime? @db.Timestamptz(3)
  heartbeatAt            DateTime? @db.Timestamptz(3)
  availableAt            DateTime         @default(now()) @db.Timestamptz(3)
  startedAt              DateTime? @db.Timestamptz(3)
  completedAt            DateTime? @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  version                Int              @default(0)
  outboxEvents           AsyncJobOutbox[]
  timelineEvents         AsyncJobEvent[]
  record                 JobRecord?

  @@index([kind, status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([resourceType, resourceId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([providerRequestId])
  @@map("async_jobs")
}

/// Append-only, payload-free task history suitable for support timelines.
/// Install assets/task-events.postgresql.sql to populate this model atomically.
model AsyncJobEvent {
  id                String          @id
  taskId            String
  sequence          Int
  eventType         String
  fromStatus        AsyncJobStatus?
  toStatus          AsyncJobStatus
  stage             String?
  progress          Int
  attempt           Int
  maxAttempts       Int
  errorCode         String?
  errorCategory     String?
  errorRetryable    Boolean?
  workerId          String?
  providerRequestId String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  task              AsyncJob        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, sequence])
  @@index([taskId, createdAt])
  @@map("async_job_events")
}

model AsyncJobOutbox {
  id             String               @id
  taskId         String
  topic          String
  payload        Json
  status         AsyncJobOutboxStatus @default(PENDING)
  attempt        Int                  @default(0)
  availableAt    DateTime             @default(now()) @db.Timestamptz(3)
  workerId       String?
  leaseToken     String?
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  publishedAt    DateTime? @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  task           AsyncJob             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([taskId, createdAt])
  @@map("async_job_outbox")
}

/// Template-owned neutral result, committed together with the fenced task completion.
model JobRecord {
  taskId    String   @id
  ownerId   String
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  task      AsyncJob @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
  @@map("job_records")
}

/// Opaque delivery metadata only; recipients/content belong to DeliveryMessage.
model NotificationDelivery {
  id                     String   @id
  idempotencyKey         String   @unique
  idempotencyFingerprint String
  channel                String
  deliveryRef            String
  priority               Float    @default(0)
  status                 String   @default("PENDING")
  attempt                Int      @default(0)
  maxAttempts            Int
  availableAt            DateTime @default(now()) @db.Timestamptz(3)
  workerId               String?
  leaseToken             String?
  leaseExpiresAt         DateTime? @db.Timestamptz(3)
  providerMessageId      String?
  errorCode              String?
  errorRetryable         Boolean?
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  deliveredAt            DateTime? @db.Timestamptz(3)
  failedAt               DateTime? @db.Timestamptz(3)
  version                Int      @default(0)

  @@index([status, availableAt, priority])
  @@index([status, leaseExpiresAt])
  @@map("notification_deliveries")
}

/// Private consumer-owned mail envelope; no account verification/reset bearer tickets.
model DeliveryMessage {
  id                   String   @id
  ownerId              String
  taskId               String?
  providerId           String
  providerAccountScope String
  recipient            String
  subject              String
  text                 String
  dispatchStartedAt    DateTime? @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@map("delivery_messages")
}


// Consumer-owned CMS. Draft route/content changes never replace a published snapshot until publish.
model siteContentEntry {
