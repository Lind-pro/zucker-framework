  name          String
  description   String?
  subject       String?
  htmlContentEn String
  htmlContentZh String?
  variables     Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("email_templates")
}

/// Final delivery history written by MailService.
model emailLogs {
  id           String   @id @default(cuid())
  userId       String?
  recipient    String
  subject      String
  template     String?
  provider     String?
  messageId    String?
  status       String
  errorMessage String?
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([recipient])
  @@index([userId])
  @@index([template, status, userId, createdAt])
  @@index([createdAt])
  @@map("email_logs")
}
