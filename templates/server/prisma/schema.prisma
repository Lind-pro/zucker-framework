}


model quotaUsage {
  subjectId String
  counter String
  period String
  limit Int
  used Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  @@id([subjectId, counter, period])
  @@map("quota_usage")
}

model quotaReservation {
  id String @id
  subjectId String
  counter String
  period String
  amount Int
  limit Int
  policyVersion String
  resourceType String
  resourceId String
  status String @default("RESERVED")
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  reason String?
  /// sha256 of (subjectId, counter, resourceType, resourceId) while RESERVED or CONFIRMED, NULL once
  /// RELEASED or EXPIRED (written by the quota store; a CHECK constraint enforces it). The unique
  /// index charges a resource once per counter while still allowing a retry after a release/expiry.
  activeResourceKey String? @unique
  @@index([subjectId, counter, period, status])
  @@index([status, expiresAt])
  @@map("quota_reservations")
}

