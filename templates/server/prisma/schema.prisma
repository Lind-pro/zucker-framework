  revision             Int      @default(0)
  createdBy            String
  updatedBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@unique([kind, locale, slug])
  @@unique([kind, locale, publishedSlug])
  @@index([kind, locale, status, publishedAt, id])
  @@map("site_content_entries")
}

model siteContentCategory {
  id                String   @id
  locale            String
  slug              String
  draft             Json
  status            String   @default("draft")
