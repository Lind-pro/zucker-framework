// DictionaryService 使用 db.model('dictionary') / db.model('dictionaryItem')
// 注意：Prisma 已有 dictionaries/dictionaryItems 模型，
// 但代码使用的是 singular 形式。PrismaAdapter 需要做名称映射。
// 这里添加 @@map 别名注释供参考，实际应在 PrismaAdapter 中处理。

// Private objects stay in storage; this table is the durable ownership/recovery journal.
model fileAssets {
  id                 String   @id
  ownerId            String
  idempotencyKey     String
  objectKey          String   @unique
