# Server-side API base URL, including the backend's /api prefix.
# Requests to this app's /api/* are forwarded to this base URL.
API_URL=http://localhost:4200/api
# Public origin used for every canonical, hreflang, Open Graph and sitemap URL (never the request
# Host). Origin only: no path, query or credentials. Match the Server WEB_URL.
SITE_URL=http://localhost:4202
# Default routed locale: en or zh (both always ship). Read at build time; the default locale is
# served without a prefix (/pricing), the other with one (/zh/pricing). Empty means en.
DEFAULT_LOCALE=en
# Verifies the Server's signed cache revalidation calls (POST /api/revalidate). Same value as the
# Server's REVALIDATE_SECRET, at least 32 characters; empty disables the endpoint (404).
REVALIDATE_SECRET=
# Optional back-office URL shown in the signed-in header menu to accounts holding permissions.
# It appears in public page payloads; leave empty to hide the link. Access is enforced by the Server.
ADMIN_URL=
# New applications read the Server's applied public connection settings. On failure, scripts stay off.
# Set environment explicitly only when this Web deployment owns the public settings below.
SITE_CONFIGURATION_SOURCE=server

# Optional browser analytics. All connections are off unless BOTH switches are true.
# These are public site identifiers, never server API secrets. The application owns consent.
SITE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_MEASUREMENT_ID=
CLARITY_ENABLED=false
CLARITY_PROJECT_ID=
PLAUSIBLE_ENABLED=false
# Copy this site's current installation script URL (or a configured same-origin proxy path).
PLAUSIBLE_SCRIPT_URL=
OPENPANEL_ENABLED=false
OPENPANEL_CLIENT_ID=
# Optional HTTPS / same-origin API base; never set an OpenPanel client secret here.
OPENPANEL_API_URL=
VERCEL_ANALYTICS_ENABLED=false
# Copy the same-origin script path provided by the enabled Vercel project's setup.
VERCEL_ANALYTICS_SCRIPT_PATH=

# Optional advertising, referral and support connections. Public pages only; all off by default.
# The consumer decides consent before enabling/mounting. No automatic user identification.
SITE_CONNECTIONS_ENABLED=false
ADSENSE_ENABLED=false
# Exact public client ID from AdSense: ca-pub- followed by 16 digits. Also controls root /ads.txt.
ADSENSE_PUBLISHER_ID=
AFFONSO_ENABLED=false
AFFONSO_PROGRAM_ID=
AFFONSO_COOKIE_DURATION_DAYS=30
PROMOTEKIT_ENABLED=false
PROMOTEKIT_PROGRAM_ID=
CRISP_ENABLED=false
CRISP_WEBSITE_ID=
TAWK_ENABLED=false
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
