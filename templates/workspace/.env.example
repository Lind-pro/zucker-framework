# One configuration file for the whole workspace. `zucker create` wrote `.env` from this file with
# random secrets (mode 0600). Never commit `.env`. Values below are for the host (pnpm dev); the
# compose file overrides only container-internal hosts (postgres, redis, minio, mailpit, server).

# ─── Local stack (docker-compose.yml) ─────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
# Object-storage root account (SeaweedFS S3, service `minio`); the application uses the FILES_S3_* account,
# limited to FILES_S3_BUCKET (created by minio-init).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
# Mailpit catches every outgoing message locally: http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SERVER_PORT=4200
WEB_PORT=4202
ADMIN_PORT=4201
# Interface the web and admin containers listen on. 127.0.0.1 keeps them private to this machine;
# put a TLS reverse proxy in front before exposing them (0.0.0.0).
PUBLIC_BIND=127.0.0.1

# Default routed locale of Web and Admin: en or zh (both always ship). Web reads it at build time.
DEFAULT_LOCALE=en
VITE_DEFAULT_LOCALE=en
# Signs cache revalidation requests between Server and Web.
REVALIDATE_SECRET=

# Optional package registry for the Docker image builds (a private mirror); default registry.npmjs.org.
# NPM_REGISTRY=
